#include <stdio.h>
#include <stdlib.h>
int main(){
    int rows=2, cols=2;
    int **a = (int**)malloc(rows*sizeof(int*));
    int **b = (int**)malloc(rows*sizeof(int*));
    int **sum = (int**)malloc(rows*sizeof(int*));
    for(int i=0;i<rows;i++){
        a[i]=(int*)malloc(cols*sizeof(int));
        b[i]=(int*)malloc(cols*sizeof(int));
        sum[i]=(int*)malloc(cols*sizeof(int));
    }
    int count=1;
    for(int i=0;i<rows;i++)
        for(int j=0;j<cols;j++) { a[i][j]=count; b[i][j]=count+1; count++;}
    for(int i=0;i<rows;i++)
        for(int j=0;j<cols;j++) sum[i][j]=a[i][j]+b[i][j];
    for(int i=0;i<rows;i++){
        for(int j=0;j<cols;j++) printf("%d ", sum[i][j]);
        printf("\n");
    }
    return 0;
}
