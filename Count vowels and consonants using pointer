#include <stdio.h>
int main(){
    char str[]="Hello";
    char *p=str;
    int v=0,c=0;
    while(*p!='\0'){
        char ch = *p;
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U') v++;
        else if((ch>='a'&&ch<='z')||(ch>='A'&&ch<='Z')) c++;
        p++;
    }
    printf("Vowels=%d Consonants=%d", v,c);
    return 0;
}
