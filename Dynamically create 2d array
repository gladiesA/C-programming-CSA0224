#include <stdio.h>
#include <stdlib.h>
int main(){
    int r=2,c=2, **arr;
    arr=(int**)malloc(r*sizeof(int*));
    for(int i=0;i<r;i++) arr[i]=(int*)malloc(c*sizeof(int));
    int val=1;
    for(int i=0;i<r;i++) for(int j=0;j<c;j++) arr[i][j]=val++;
    for(int i=0;i<r;i++) { for(int j=0;j<c;j++) printf("%d ", arr[i][j]); printf("\n"); }
    return 0;
}
