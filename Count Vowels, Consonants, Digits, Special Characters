#include <stdio.h>

int main() {
    char str[]="Hello123!";
    int v=0,c=0,d=0,s=0;

    for(int i=0;str[i]!='\0';i++){
        if(str[i]>='0' && str[i]<='9') d++;
        else if((str[i]>='a'&&str[i]<='z')||(str[i]>='A'&&str[i]<='Z')){
            if(str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u')
                v++;
            else c++;
        }
        else s++;
    }

    printf("Vowels=%d Consonants=%d Digits=%d Special=%d",v,c,d,s);
    return 0;
}
