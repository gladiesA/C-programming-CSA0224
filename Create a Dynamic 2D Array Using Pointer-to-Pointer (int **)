#include <stdio.h>
#include <stdlib.h>

int main() {
    int rows = 2, cols = 3;
    int **arr;

    // Allocate memory for rows
    arr = (int **)malloc(rows * sizeof(int *));

    // Allocate memory for columns
    for(int i = 0; i < rows; i++) {
        arr[i] = (int *)malloc(cols * sizeof(int));
    }

    // Assign values
    int count = 1;
    for(int i = 0; i < rows; i++) {
        for(int j = 0; j < cols; j++) {
            arr[i][j] = count++;
        }
    }

    // Print array
    for(int i = 0; i < rows; i++) {
        for(int j = 0; j < cols; j++) {
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }

    // Free memory
    for(int i = 0; i < rows; i++)
        free(arr[i]);
    free(arr);

    return 0;
}
