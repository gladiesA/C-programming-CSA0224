#include <stdio.h>
#include <string.h>

int main() {
    char str[]="I love programming";
    char word[20], max[20];
    int i=0,j=0,maxlen=0;

    while(1){
        if(str[i]!=' ' && str[i]!='\0')
            word[j++]=str[i];
        else{
            word[j]='\0';
            if(strlen(word)>maxlen){
                maxlen=strlen(word);
                strcpy(max,word);
            }
            j=0;
        }
        if(str[i]=='\0') break;
        i++;
    }

    printf("Longest Word = %s",max);
    return 0;
}
