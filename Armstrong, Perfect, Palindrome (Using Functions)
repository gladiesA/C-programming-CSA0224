#include <stdio.h>

void check(int n) {
    int sum=0,temp=n,r;

    while(temp>0){ r=temp%10; sum+=r*r*r; temp/=10; }

    if(sum==n) printf("Armstrong\n");

    sum=0;
    for(int i=1;i<n;i++)
        if(n%i==0) sum+=i;
    if(sum==n) printf("Perfect\n");

    temp=n; sum=0;
    while(temp>0){ r=temp%10; sum=sum*10+r; temp/=10; }
    if(sum==n) printf("Palindrome\n");
}

int main() {
    check(153);
    return 0;
}
