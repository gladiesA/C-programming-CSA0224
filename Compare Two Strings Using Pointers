#include <stdio.h>

int main() {
    char s1[] = "abc";
    char s2[] = "abc";
    char *p1 = s1, *p2 = s2;

    while(*p1 && *p2 && *p1 == *p2) {
        p1++;
        p2++;
    }

    if(*p1 == *p2)
        printf("Strings are Equal");
    else
        printf("Strings are Not Equal");

    return 0;
}
